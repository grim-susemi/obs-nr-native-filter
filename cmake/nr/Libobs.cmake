# Import against actual installed OBS 32.2.2 exports, not template 31.1.1.
set(NR_OBS_DLL "C:/Program Files/obs-studio/bin/64bit/obs.dll" CACHE FILEPATH "Admitted installed libobs")
file(SHA256 "${NR_OBS_DLL}" nr_obs_hash)
if(NOT nr_obs_hash STREQUAL "9b9a76f64a1d27262209f1cfbeaf6d57a175cc4e823c71882bb7d5b5ab99bdcf")
  message(FATAL_ERROR "Installed libobs identity changed; re-admission required")
endif()
set(nr_msvc "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64")
execute_process(COMMAND "${nr_msvc}/dumpbin.exe" /exports "${NR_OBS_DLL}" OUTPUT_VARIABLE nr_exports COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" nr_lines "${nr_exports}")
set(nr_def "LIBRARY obs.dll\nEXPORTS\n")
foreach(line IN LISTS nr_lines)
  if(line MATCHES "^[ ]+[0-9]+[ ]+[0-9A-F]+[ ]+[0-9A-F]+[ ]+([^ \r]+)")
    string(APPEND nr_def "${CMAKE_MATCH_1}\n")
  endif()
endforeach()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/nr-import")
file(WRITE "${CMAKE_BINARY_DIR}/nr-import/obs.def" "${nr_def}")
execute_process(COMMAND "${nr_msvc}/lib.exe" /nologo /machine:x64 "/def:${CMAKE_BINARY_DIR}/nr-import/obs.def" "/out:${CMAKE_BINARY_DIR}/nr-import/obs.lib" COMMAND_ERROR_IS_FATAL ANY)
# Windows layout from pinned cmake/windows/defaults.cmake; stable release values.
set(OBS_DATA_PATH "../../data")
set(OBS_PLUGIN_PATH "../../obs-plugins/64bit")
set(OBS_PLUGIN_DESTINATION "obs-plugins/64bit")
set(OBS_RELEASE_CANDIDATE 0)
set(OBS_BETA 0)
configure_file(deps/obs-headers/libobs/obsconfig.h.in "${CMAKE_BINARY_DIR}/nr-import/obsconfig.h" @ONLY)
add_library(OBS::libobs SHARED IMPORTED GLOBAL)
set_target_properties(OBS::libobs PROPERTIES IMPORTED_LOCATION "${NR_OBS_DLL}" IMPORTED_IMPLIB "${CMAKE_BINARY_DIR}/nr-import/obs.lib" INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/deps/obs-headers/libobs;${CMAKE_BINARY_DIR}/nr-import")
