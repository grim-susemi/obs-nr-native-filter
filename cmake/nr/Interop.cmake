# Task7 transport leaf; shared owner includes this explicitly.
get_filename_component(NR_INTEROP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
add_library(nr_interop STATIC "${NR_INTEROP_ROOT}/src/interop.cpp")
target_include_directories(nr_interop PUBLIC "${NR_INTEROP_ROOT}/src")
target_compile_features(nr_interop PUBLIC cxx_std_20)
target_compile_definitions(nr_interop PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(nr_interop PRIVATE /W4 /WX /permissive-)
target_link_libraries(nr_interop PUBLIC d3d11 d3d12 dxgi)
add_executable(interop_contract_tests "${NR_INTEROP_ROOT}/tools/tests/interop_contract_tests.cpp")
target_link_libraries(interop_contract_tests PRIVATE nr_interop)
target_compile_options(interop_contract_tests PRIVATE /W4 /WX /permissive-)
add_test(NAME interop_contract COMMAND interop_contract_tests)
find_program(NR_INTEROP_FXC NAMES fxc.exe HINTS "C:/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64" REQUIRED)
foreach(entry IN ITEMS vertex pixel)
 if(entry STREQUAL "vertex")
  set(profile vs_5_0)
 else()
  set(profile ps_5_0)
 endif()
 set(output "${CMAKE_CURRENT_BINARY_DIR}/nr_interop_${entry}.cso")
 add_custom_command(OUTPUT "${output}"
  COMMAND "${NR_INTEROP_FXC}" /nologo /WX /Ges /Gis /T "${profile}" /E "${entry}" /Fo "${output}" "${NR_INTEROP_ROOT}/src/shaders/nr_interop_blit.hlsl"
  DEPENDS "${NR_INTEROP_ROOT}/src/shaders/nr_interop_blit.hlsl" VERBATIM)
 list(APPEND NR_INTEROP_SHADERS "${output}")
endforeach()
add_custom_target(nr_interop_shaders DEPENDS ${NR_INTEROP_SHADERS})
add_dependencies(nr_interop nr_interop_shaders)
