# Task10 CPU scheduling leaf; shared steward includes explicitly after acceptance.
get_filename_component(NR_SCHEDULER_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
add_library(nr_scheduler STATIC "${NR_SCHEDULER_ROOT}/src/frame_pipeline.cpp")
target_include_directories(nr_scheduler PUBLIC "${NR_SCHEDULER_ROOT}/src")
target_compile_features(nr_scheduler PUBLIC cxx_std_20)
target_compile_definitions(nr_scheduler PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(nr_scheduler PRIVATE /W4 /WX /permissive-)
foreach(target IN ITEMS scheduler_contract_tests scheduler_cli)
  add_executable(${target} "${NR_SCHEDULER_ROOT}/tools/tests/scheduler_contract_tests.cpp")
  target_link_libraries(${target} PRIVATE nr_scheduler)
  target_compile_options(${target} PRIVATE /W4 /WX /permissive-)
endforeach()
add_test(NAME scheduler_contract COMMAND scheduler_contract_tests)
set_tests_properties(scheduler_contract PROPERTIES TIMEOUT 60)
