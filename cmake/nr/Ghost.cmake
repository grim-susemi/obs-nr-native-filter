# Task26 disjoint CPU leaf; shared steward includes only after Stage B integration.
get_filename_component(NR_GHOST_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
add_library(nr_ghost STATIC "${NR_GHOST_ROOT}/src/ghost_fixture.cpp" "${NR_GHOST_ROOT}/src/ghost_oracle.cpp" "${NR_GHOST_ROOT}/src/ghost_freeze.cpp" "${NR_GHOST_ROOT}/src/ghost_baseline.cpp")
target_include_directories(nr_ghost PUBLIC "${NR_GHOST_ROOT}/src")
target_compile_features(nr_ghost PUBLIC cxx_std_20)
target_compile_definitions(nr_ghost PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(nr_ghost PRIVATE /W4 /WX /permissive-)
set_source_files_properties("${NR_GHOST_ROOT}/src/ghost_fixture.cpp" "${NR_GHOST_ROOT}/src/ghost_oracle.cpp" "${NR_GHOST_ROOT}/src/ghost_freeze.cpp" "${NR_GHOST_ROOT}/src/ghost_baseline.cpp"
  PROPERTIES VS_SETTINGS "Optimization=MaxSpeed;BasicRuntimeChecks=Default;FloatingPointModel=Strict")
foreach(kind IN ITEMS lineage oracle baseline raw_copy)
  add_executable(ghost_${kind}_tests "${NR_GHOST_ROOT}/tools/tests/ghost_${kind}_tests.cpp")
  target_link_libraries(ghost_${kind}_tests PRIVATE nr_ghost)
  target_compile_options(ghost_${kind}_tests PRIVATE /W4 /WX /permissive-)
  add_test(NAME ghost_${kind} COMMAND ghost_${kind}_tests)
  set_tests_properties(ghost_${kind} PROPERTIES TIMEOUT 120)
endforeach()
if(NOT TARGET nr_scheduler)
  # Standalone CPU foundation links the owned implementation, never a scheduler model.
  add_library(nr_ghost_cpu_scheduler STATIC "${NR_GHOST_ROOT}/src/frame_pipeline.cpp" "${NR_GHOST_ROOT}/src/interop.cpp")
  target_include_directories(nr_ghost_cpu_scheduler PUBLIC "${NR_GHOST_ROOT}/src")
  target_compile_features(nr_ghost_cpu_scheduler PUBLIC cxx_std_20)
  target_compile_definitions(nr_ghost_cpu_scheduler PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
  target_compile_options(nr_ghost_cpu_scheduler PRIVATE /W4 /WX /permissive-)
  target_link_libraries(nr_ghost_cpu_scheduler PUBLIC d3d11 d3d12 dxgi)
  target_link_libraries(ghost_lineage_tests PRIVATE nr_ghost_cpu_scheduler)
else()
  target_link_libraries(ghost_lineage_tests PRIVATE nr_scheduler)
endif()
