target_compile_options(runtime_driver_binding_tests PRIVATE /W4 /WX /permissive-)
add_test(NAME runtime_driver_binding COMMAND runtime_driver_binding_tests)
add_executable(runtime_contract ${CMAKE_CURRENT_LIST_DIR}/../../tools/tests/runtime_contract_tests.cpp)
